@{
    ViewData["Title"] = "Nueva contraseña — SENPRO";
    Layout = "_Layout";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Inicio", "/"),
        ("Iniciar sesión", "/Account/Login"),
        ("Nueva contraseña", null)
    };
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <img src="~/assets/images/logo.jpg" alt="SENPRO" />
            <span>SENPRO</span>
        </div>

        @if (ViewBag.TokenInvalido != null)
        {
            <h1 class="auth-title">Enlace no válido</h1>
            <div style="background:#fef2f2;border:1.5px solid #fca5a5;color:#991b1b;padding:14px 18px;border-radius:10px;margin-bottom:20px;font-size:0.9rem">
                Este enlace ha caducado o ya ha sido utilizado. Por favor, solicita uno nuevo.
            </div>
            <a asp-action="ForgotPassword" class="btn-auth" style="display:block;text-align:center;text-decoration:none">
                Solicitar nuevo enlace
            </a>
        }
        else if (ViewBag.Exito != null)
        {
            <h1 class="auth-title">Contraseña actualizada</h1>
            <div style="background:#ecfdf5;border:1.5px solid #6ee7b7;color:#065f46;padding:14px 18px;border-radius:10px;margin-bottom:24px;font-size:0.9rem;display:flex;gap:10px;align-items:center">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;flex-shrink:0">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Tu contraseña ha sido actualizada correctamente.
            </div>
            <a asp-action="Login" class="btn-auth" style="display:block;text-align:center;text-decoration:none">
                Iniciar sesión
            </a>
        }
        else
        {
            <h1 class="auth-title">Nueva contraseña</h1>
            <p class="auth-sub">Introduce tu nueva contraseña.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="auth-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <span>@error.ErrorMessage</span>
                    }
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div class="form-grupo">
                    <label for="password">Nueva contraseña</label>
                    <input type="password" name="password" id="password" placeholder="Mínimo 6 caracteres" required minlength="6" />
                </div>

                <div class="form-grupo">
                    <label for="confirmar">Confirmar contraseña</label>
                    <input type="password" name="confirmar" id="confirmar" placeholder="Repite la contraseña" required />
                </div>

                <button type="submit" class="btn-auth">Cambiar contraseña</button>
            </form>
        }
    </div>
</div>

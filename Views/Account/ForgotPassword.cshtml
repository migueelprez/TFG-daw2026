@{
    ViewData["Title"] = "Recuperar contraseña — SENPRO";
    Layout = "_Layout";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Inicio", "/"),
        ("Iniciar sesión", "/Account/Login"),
        ("Recuperar contraseña", null)
    };
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <img src="~/assets/images/logo.jpg" alt="SENPRO" />
            <span>SENPRO</span>
        </div>

        <h1 class="auth-title">Recuperar contraseña</h1>

        @if (ViewBag.Enviado != null)
        {
            <div class="auth-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;flex-shrink:0;color:#059669">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                <p>Si existe una cuenta con ese email, te hemos enviado un enlace para restablecer tu contraseña.</p>
            </div>

            @* En desarrollo: mostramos el link directamente *@
            @if (ViewBag.DebugLink != null)
            {
                <div class="auth-debug">
                    <strong>Enlace de restablecimiento (solo visible en desarrollo):</strong><br/>
                    <a href="@ViewBag.DebugLink" style="word-break:break-all;color:#2264d1;font-size:0.83rem">@ViewBag.DebugLink</a>
                </div>
            }

            <p class="auth-link" style="margin-top:20px">
                <a asp-action="Login">← Volver al inicio de sesión</a>
            </p>
        }
        else
        {
            <p class="auth-sub">Introduce tu email y te enviaremos un enlace para crear una nueva contraseña.</p>

            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grupo">
                    <label for="email">Email</label>
                    <input type="email" name="email" id="email" placeholder="tu@email.com" autocomplete="email" required />
                </div>

                <button type="submit" class="btn-auth">Enviar enlace</button>
            </form>

            <p class="auth-link">
                <a asp-action="Login">← Volver al inicio de sesión</a>
            </p>
        }
    </div>
</div>

@{
    ViewData["Title"] = "Panel de Administración — SENPRO";
}
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="admin-wrapper">

    <aside class="admin-sidebar">
        <div class="sidebar-logo">
            <img src="~/assets/images/logo.jpg" alt="SENPRO" />
            <span>Admin Panel</span>
        </div>
        <nav class="sidebar-nav">
            <a asp-controller="Admin" asp-action="Index"        class="sidebar-link activo">📊 Dashboard</a>
            <a asp-controller="Admin" asp-action="Productos"   class="sidebar-link">📦 Productos</a>
            <a asp-controller="Admin" asp-action="Usuarios"    class="sidebar-link">👥 Usuarios</a>
            <a asp-controller="Admin" asp-action="Pedidos"     class="sidebar-link">🧾 Pedidos</a>
            <a asp-controller="Admin" asp-action="Presupuestos" class="sidebar-link">💼 Presupuestos</a>
            <a asp-controller="Admin" asp-action="Estadisticas" class="sidebar-link">📈 Estadísticas</a>
            <hr class="sidebar-divider" />
            <a asp-controller="Home"  asp-action="Index"       class="sidebar-link">🌐 Ver la web</a>
            <a asp-controller="Account" asp-action="Logout"    class="sidebar-link sidebar-logout">⬅ Cerrar sesión</a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="admin-header">
            <h1>Dashboard</h1>
            <p>Bienvenido, @User.Identity!.Name. Aquí tienes el resumen de SENPRO.</p>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="admin-toast">✓ @TempData["Exito"]</div>
        }

        <div class="stats-grid">
            <div class="stat-card azul">
                <div class="stat-icono">📦</div>
                <div class="stat-datos">
                    <span class="stat-numero">@ViewBag.TotalProductos</span>
                    <span class="stat-label">Productos</span>
                </div>
            </div>
            <div class="stat-card verde">
                <div class="stat-icono">👥</div>
                <div class="stat-datos">
                    <span class="stat-numero">@ViewBag.TotalUsuarios</span>
                    <span class="stat-label">Usuarios registrados</span>
                </div>
            </div>
            <div class="stat-card naranja">
                <div class="stat-icono">🛒</div>
                <div class="stat-datos">
                    <span class="stat-numero">@ViewBag.TotalPedidos</span>
                    <span class="stat-label">Pedidos totales</span>
                </div>
            </div>
            <div class="stat-card morado">
                <div class="stat-icono">💶</div>
                <div class="stat-datos">
                    <span class="stat-numero">@(((double)ViewBag.Ingresos).ToString("N2")) €</span>
                    <span class="stat-label">Ingresos confirmados</span>
                </div>
            </div>
            <div class="stat-card rojo">
                <div class="stat-icono">💼</div>
                <div class="stat-datos">
                    <span class="stat-numero">@ViewBag.SolicitudesPendientes</span>
                    <span class="stat-label">Presupuestos pendientes</span>
                </div>
            </div>
        </div>

        <div class="admin-seccion">
            <div class="seccion-header">
                <h2>Últimos pedidos</h2>
            </div>
            <div class="tabla-wrapper">
                <table class="admin-tabla">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in (IEnumerable<TFG.Models.Pedido>)ViewBag.UltimosPedidos)
                        {
                            <tr>
                                <td>#@pedido.Id</td>
                                <td>@(pedido.Usuario?.Nombre ?? "—")</td>
                                <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@pedido.Total.ToString("N2") €</td>
                                <td>
                                    <span class="badge-estado @pedido.Estado.ToLower()">
                                        @pedido.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!((IEnumerable<TFG.Models.Pedido>)ViewBag.UltimosPedidos).Any())
                        {
                            <tr><td colspan="5" style="text-align:center;color:#999">Sin pedidos aún</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="admin-accesos-rapidos">
            <a asp-controller="Admin" asp-action="NuevoProducto" class="btn-admin-accion">+ Nuevo producto</a>
            <a asp-controller="Admin" asp-action="Usuarios"      class="btn-admin-accion secundario">Gestionar usuarios</a>
            <a asp-controller="Admin" asp-action="Estadisticas"  class="btn-admin-accion secundario">Ver estadísticas</a>
        </div>
    </main>
</div>

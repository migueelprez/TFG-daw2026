@model TFG.Models.Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
    Layout = null; // Sin layout para impresión limpia
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pedido #@Model.Id — SENPRO</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; }
        body { background: #f8fafc; color: #0f172a; }

        /* ── BARRA DE ACCIONES (solo pantalla) ── */
        .acciones-bar {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 14px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .acciones-bar a {
            color: #2264d1;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .btn-pdf {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            background: #2264d1;
            color: #fff !important;
            border: none;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none !important;
            transition: background 0.2s;
        }
        .btn-pdf:hover { background: #1a4da3; }

        /* ── DOCUMENTO ── */
        .documento {
            max-width: 820px;
            margin: 32px auto;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 32px rgba(15,23,42,0.1);
            overflow: hidden;
        }

        /* Cabecera azul */
        .doc-cabecera {
            background: linear-gradient(135deg, #1a3d8f, #2264d1);
            color: #fff;
            padding: 40px 48px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .doc-empresa h1 {
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }

        .doc-empresa p { font-size: 0.83rem; opacity: 0.72; line-height: 1.6; }

        .doc-titulo-pedido { text-align: right; }
        .doc-titulo-pedido h2 { font-size: 1.3rem; font-weight: 800; margin-bottom: 4px; }
        .doc-titulo-pedido p  { font-size: 0.83rem; opacity: 0.8; }

        /* Datos del pedido */
        .doc-datos {
            padding: 28px 48px;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 24px;
            border-bottom: 1px solid #f1f5f9;
        }

        .dato-bloque label {
            display: block;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #94a3b8;
            margin-bottom: 6px;
        }

        .dato-bloque p {
            font-size: 0.93rem;
            color: #0f172a;
            font-weight: 500;
            line-height: 1.5;
        }

        .estado-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .estado-Pendiente { background: #fef3c7; color: #92400e; }
        .estado-Pagado    { background: #dcfce7; color: #166534; }
        .estado-Cancelado { background: #fef2f2; color: #991b1b; }

        /* Tabla de líneas */
        .doc-lineas { padding: 28px 48px; }

        .doc-lineas h3 {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #94a3b8;
            margin-bottom: 16px;
        }

        .tabla-lineas {
            width: 100%;
            border-collapse: collapse;
        }

        .tabla-lineas thead tr {
            background: #f8fafc;
        }

        .tabla-lineas th {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #64748b;
            padding: 10px 14px;
            text-align: left;
            border-bottom: 2px solid #e2e8f0;
        }

        .tabla-lineas th:last-child,
        .tabla-lineas td:last-child { text-align: right; }

        .tabla-lineas td {
            padding: 12px 14px;
            font-size: 0.9rem;
            color: #374151;
            border-bottom: 1px solid #f1f5f9;
        }

        .tabla-lineas tr:last-child td { border-bottom: none; }

        /* Total */
        .doc-total {
            padding: 20px 48px 40px;
            display: flex;
            justify-content: flex-end;
        }

        .total-caja {
            background: #f0f5ff;
            border-radius: 12px;
            padding: 20px 28px;
            min-width: 260px;
        }

        .total-linea {
            display: flex;
            justify-content: space-between;
            font-size: 0.88rem;
            color: #64748b;
            margin-bottom: 8px;
        }

        .total-final {
            display: flex;
            justify-content: space-between;
            font-size: 1.2rem;
            font-weight: 800;
            color: #0f172a;
            border-top: 2px solid #dce8fb;
            padding-top: 12px;
            margin-top: 8px;
        }

        /* Pie */
        .doc-pie {
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            padding: 16px 48px;
            font-size: 0.78rem;
            color: #94a3b8;
            text-align: center;
        }

        /* ── ESTILOS DE IMPRESIÓN ── */
        @@media print {
            body { background: #fff; }
            .acciones-bar { display: none !important; }
            .documento {
                max-width: 100%;
                margin: 0;
                border-radius: 0;
                box-shadow: none;
            }
            .doc-cabecera { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .estado-Pagado, .estado-Pendiente, .estado-Cancelado {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>

    @* Barra acciones (solo pantalla) *@
    <div class="acciones-bar">
        <a href="/Admin/Pedidos">← Volver a pedidos</a>
        <button class="btn-pdf" onclick="window.print()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px">
                <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
            </svg>
            Descargar PDF
        </button>
    </div>

    @* Documento imprimible *@
    <div class="documento">

        @* Cabecera *@
        <div class="doc-cabecera">
            <div class="doc-empresa">
                <h1>SENPRO</h1>
                <p>pedidos@senprosan.es · 683 347 806<br/>Plaza Nicanor Piñole 1, Gijón 33205</p>
            </div>
            <div class="doc-titulo-pedido">
                <h2>PEDIDO #@Model.Id</h2>
                <p>Fecha: @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        @* Datos *@
        <div class="doc-datos">
            <div class="dato-bloque">
                <label>Cliente</label>
                @if (Model.Usuario != null)
                {
                    <p>@Model.Usuario.Nombre<br/><span style="color:#64748b;font-size:0.83rem">@Model.Usuario.Email</span></p>
                }
                else
                {
                    <p>—</p>
                }
            </div>
            <div class="dato-bloque">
                <label>Estado</label>
                <p><span class="estado-badge estado-@Model.Estado">@Model.Estado</span></p>
            </div>
            <div class="dato-bloque">
                <label>Referencia Stripe</label>
                <p style="font-size:0.8rem;word-break:break-all">
                    @(string.IsNullOrEmpty(Model.StripeSessionId) ? "—" : Model.StripeSessionId)
                </p>
            </div>
        </div>

        @* Líneas *@
        <div class="doc-lineas">
            <h3>Detalle del pedido</h3>
            <table class="tabla-lineas">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio unit.</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lineas != null)
                    {
                        @foreach (var linea in Model.Lineas)
                        {
                            <tr>
                                <td>@linea.NombreProducto</td>
                                <td>@linea.PrecioUnitario.ToString("N2") €</td>
                                <td>@linea.Cantidad</td>
                                <td><strong>@((linea.Cantidad * linea.PrecioUnitario).ToString("N2")) €</strong></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* Total *@
        <div class="doc-total">
            <div class="total-caja">
                <div class="total-linea">
                    <span>Subtotal</span>
                    <span>@Model.Total.ToString("N2") €</span>
                </div>
                <div class="total-linea">
                    <span>IVA (21%)</span>
                    <span>Incluido</span>
                </div>
                <div class="total-final">
                    <span>TOTAL</span>
                    <span>@Model.Total.ToString("N2") €</span>
                </div>
            </div>
        </div>

        @* Pie *@
        <div class="doc-pie">
            Documento generado automáticamente por el sistema SENPRO · @DateTime.Now.Year
        </div>
    </div>

</body>
</html>

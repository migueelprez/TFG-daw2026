@model TFG.Models.ProductoModel
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nuevo Producto" : "Editar Producto";
}
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="admin-wrapper">
    <aside class="admin-sidebar">
        <div class="sidebar-logo">
            <img src="~/assets/images/logo.jpg" alt="SENPRO" />
            <span>Admin Panel</span>
        </div>
        <nav class="sidebar-nav">
            <a asp-controller="Admin" asp-action="Index"        class="sidebar-link">📊 Dashboard</a>
            <a asp-controller="Admin" asp-action="Productos"    class="sidebar-link activo">📦 Productos</a>
            <a asp-controller="Admin" asp-action="Usuarios"     class="sidebar-link">👥 Usuarios</a>
            <a asp-controller="Admin" asp-action="Pedidos"      class="sidebar-link">🧾 Pedidos</a>
            <a asp-controller="Admin" asp-action="Presupuestos" class="sidebar-link">💼 Presupuestos</a>
            <a asp-controller="Admin" asp-action="Estadisticas" class="sidebar-link">📈 Estadísticas</a>
            <hr class="sidebar-divider" />
            <a asp-controller="Home"  asp-action="Index"        class="sidebar-link">🌐 Ver la web</a>
            <a asp-controller="Account" asp-action="Logout"     class="sidebar-link sidebar-logout">⬅ Cerrar sesión</a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="admin-header">
            <h1>@(esNuevo ? "Nuevo Producto" : "Editar Producto")</h1>
            <a asp-action="Productos" class="btn-admin-accion secundario">← Volver</a>
        </div>

        <div class="admin-seccion" style="max-width:680px">
            <form asp-action="GuardarProducto" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="form-grupo">
                    <label asp-for="Nombre">Nombre del producto</label>
                    <input asp-for="Nombre" placeholder="Ej: Protector de Espinilla Premium" />
                    <span asp-validation-for="Nombre" class="campo-error"></span>
                </div>

                <div class="form-grupo">
                    <label asp-for="Categoria">Categoría</label>
                    <select asp-for="Categoria">
                        <option value="">— Selecciona categoría —</option>
                        <option value="Espinilleras">Espinilleras</option>
                        <option value="Empapadores">Empapadores</option>
                        <option value="Lencería">Lencería</option>
                        <option value="Mobiliario">Mobiliario</option>
                        <option value="Movilidad">Movilidad</option>
                        <option value="Antiescaras">Antiescaras</option>
                        <option value="Sujeción">Sujeción</option>
                    </select>
                    <span asp-validation-for="Categoria" class="campo-error"></span>
                </div>

                <div class="form-grupo">
                    <label asp-for="Precio">Precio (€)</label>
                    <input asp-for="Precio" type="number" step="0.01" min="0" placeholder="0.00" />
                    <span asp-validation-for="Precio" class="campo-error"></span>
                </div>

                <div class="form-grupo">
                    <label asp-for="Stock">Stock disponible (unidades)</label>
                    <input asp-for="Stock" type="number" min="0" placeholder="50" />
                    <small style="color:#888">Pon 0 para marcarlo como agotado.</small>
                    <span asp-validation-for="Stock" class="campo-error"></span>
                </div>

                <div class="form-grupo">
                    <label asp-for="ImagenUrl">Ruta de imagen</label>
                    <input asp-for="ImagenUrl" placeholder="Ej: espinilleras/imagen.png" />
                    <small style="color:#888">Ruta relativa dentro de wwwroot/assets/images/</small>
                    <span asp-validation-for="ImagenUrl" class="campo-error"></span>
                </div>

                <div class="form-grupo">
                    <label asp-for="Descripcion">Descripción</label>
                    <textarea asp-for="Descripcion" rows="4" placeholder="Descripción del producto..."></textarea>
                    <span asp-validation-for="Descripcion" class="campo-error"></span>
                </div>

                <div style="display:flex;gap:12px;margin-top:8px">
                    <button type="submit" class="btn-auth" style="max-width:200px">
                        @(esNuevo ? "Crear producto" : "Guardar cambios")
                    </button>
                    <a asp-action="Productos" class="btn-auth" style="max-width:140px;background:#6c757d;text-align:center">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

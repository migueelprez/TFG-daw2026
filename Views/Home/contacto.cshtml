@model TFG.Models.ContactoModel
@{
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Inicio", "/"),
        ("Contacto", null)
    };
}
<link rel="stylesheet" href="~/css/contacto.css" asp-append-version="true" />

<div class="contacto-wrapper">

    @* ── COLUMNA IZQUIERDA: INFO ── *@
    <aside class="contacto-info">
        <div class="info-inner">
            <span class="info-pretitulo">Hablemos</span>
            <h1>Estamos aquí para ayudarte</h1>
            <p class="info-desc">
                Cuéntanos qué necesita tu residencia. Nuestro equipo te responderá
                en menos de 24&nbsp;horas con una propuesta personalizada.
            </p>

            <div class="info-datos">
                <div class="dato-item">
                    <div class="dato-icono">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.5 2 2 0 0 1 3.59 1.32h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.88a16 16 0 0 0 6.29 6.29l.83-.83a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/>
                        </svg>
                    </div>
                    <div>
                        <span class="dato-label">Teléfono</span>
                        <span class="dato-valor">683 347 806</span>
                    </div>
                </div>

                <div class="dato-item">
                    <div class="dato-icono">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <div>
                        <span class="dato-label">Email</span>
                        <span class="dato-valor">pedidos@senprosan.es</span>
                    </div>
                </div>

                <div class="dato-item">
                    <div class="dato-icono">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div>
                        <span class="dato-label">Dirección</span>
                        <span class="dato-valor">Plaza Nicanor Piñole 1,<br/>Esc. Izda, 1ª Dcha<br/>33205 Gijón, Asturias</span>
                    </div>
                </div>
            </div>

            <div class="info-horario">
                <span class="dato-label">Horario de atención</span>
                <span class="dato-valor">Lun – Vie &nbsp;·&nbsp; 09:00 – 18:00</span>
            </div>
        </div>
    </aside>

    @* ── COLUMNA DERECHA: FORMULARIO ── *@
    <main class="contacto-form-panel">
        <div class="form-inner">

            @if (ViewBag.MensajeExito != null)
            {
                <div class="alerta-exito">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;flex-shrink:0">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    @ViewBag.MensajeExito
                </div>
            }

            <h2>Envíanos un mensaje</h2>
            <p class="form-subtitulo">Rellena el formulario y te contactamos a la mayor brevedad.</p>

            <form asp-action="Contacto" method="post" class="form-senpro">

                <div class="form-fila">
                    <div class="form-group">
                        <label asp-for="Nombre">Nombre completo <span class="req">*</span></label>
                        <input asp-for="Nombre" type="text" placeholder="Tu nombre y apellidos" required />
                    </div>
                    <div class="form-group">
                        <label asp-for="Telefono">Teléfono</label>
                        <input asp-for="Telefono" type="tel" placeholder="600 000 000" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Correo electrónico <span class="req">*</span></label>
                    <input asp-for="Email" type="email" placeholder="tu@residencia.com" required />
                </div>

                <div class="form-group">
                    <label asp-for="Asunto">Asunto <span class="req">*</span></label>
                    <select asp-for="Asunto" required>
                        <option value="">— Selecciona un asunto —</option>
                        <option value="Solicitud de presupuesto">Solicitud de presupuesto</option>
                        <option value="Información sobre productos">Información sobre productos</option>
                        <option value="Muestra gratuita">Muestra gratuita</option>
                        <option value="Pedido o envío">Pedido o envío</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Mensaje">Mensaje <span class="req">*</span></label>
                    <textarea asp-for="Mensaje" rows="5" placeholder="Cuéntanos qué necesita tu residencia..."></textarea>
                </div>

                <button type="submit" class="btn-enviar">
                    Enviar mensaje
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:17px;height:17px">
                        <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>

            </form>
        </div>
    </main>

</div>
